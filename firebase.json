{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": 
    {
      "public": "send-din-din/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/createPaymentIntent",
          "function": "createPaymentIntent"
        },
        {
          "source": "/createCoraPixCharge",
          "function": "createCoraPixCharge"
        },
        {
          "source": "/checkCoraPixStatus",
          "function": "checkCoraPixStatus"
        },
        { 
          "source": "/getStripePublicKey",
         "function": "getStripePublicKey" 
        },
        {
          "source": "/getTenantBySlug",
          "function": "getTenantBySlug"
        },
        {
          "source": "/a/**",
          "function": "iotRouter"
        },
        {         
          "source": "/createPagBankOrder",
          "function": "createPagBankOrder"
        },
        {
          "source": "/api/seed",
          "function": "iotSeed"
        },
        {
          "source": "/api/device/sync",
          "function": "iotRouter"
        },
        {
          "source": "/api/device/event",
          "function": "iotRouter"
        },
        {
          "source": "/go/**",
          "function": "iotRouter"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
}
