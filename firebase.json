{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "send-din-din/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/createPaymentIntent",
        "function": "createPaymentIntent"
      },
      {
        "source": "/a",
        "function": "redirectAuto"
      },
      {
        "source": "/createCoraPixCharge",
        "function": "createCoraPixCharge"
      },
      {
        "source": "/checkCoraPixStatus",
        "function": "checkCoraPixStatus"
      },
      { "source": "/getStripePublicKey", "function": "getStripePublicKey" },
      {
        "source": "/getTenantBySlug",
        "function": "getTenantBySlug"
      },
      {
        "source": "/createTenant",
        "function": "createTenant"
      },
      {
        "source": "/api/tenants",
        "function": "createTenant"
      },
      {
        "source": "/a/**",
        "function": "iotRouter"
      },
      {
        "source": "/createPagBankOrder",
        "function": "createPagBankOrder"
      },
      {
        "source": "/api/seed",
        "function": "iotSeed"
      },
      {
        "source": "/api/device/sync",
        "function": "iotRouter"
      },
      {
        "source": "/api/device/event",
        "function": "iotRouter"
      },
      {
        "source": "/go/**",
        "function": "iotRouter"
      },
      {
        "source": "/api/webhook-pix/**",
        "function": "proxyPixWebhook"
      },
      {
        "source": "/api/form-submissions",
        "function": "saveFormSubmission"
      },
      {
        "source": "/api/tenant-tags/update-url",
        "function": "updateTenantTagUrl"
      },
      {
        "source": "/api/tags/update-by-ids",
        "function": "updateTagUrlByIds"
      },
      {
        "source": "/api/tags",
        "function": "listTags"
      },
      {
        "source": "/api/tags/kpis",
        "function": "getTagKpis"
      },
      {
        "source": "/api/tags/assign-sector",
        "function": "assignTagSector"
      },
      {
        "source": "/api/tags/remove-sector",
        "function": "removeTagSector"
      },
      {
        "source": "/api/tag-sectors/update-url",
        "function": "updateSectorUrl"
      },
      {
        "source": "/api/tag-sectors",
        "function": "listTagSectors"
      },
      {
        "source": "/api/tag-sectors/**",
        "function": "listTagSectors"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
