{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": [
    {
    "target": "wasser-c430a",
    "public": "send-din-din/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/createPaymentIntent",
        "function": "createPaymentIntent"
      },
      {
        "source": "/createCoraPixCharge",
        "function": "createCoraPixCharge"
      },
      {
        "source": "/checkCoraPixStatus",
        "function": "checkCoraPixStatus"
      },
      {
        "source": "/a",
        "function": "redirectAuto"
      },
      {
        "source": "/api/seed",
        "function": "iotSeed"
      },
      {
        "source": "/api/device/sync",
        "function": "iotRouter"
      },
      {
        "source": "/api/device/event",
        "function": "iotRouter"
      },
      {
        "source": "/go/**",
        "function": "iotRouter"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }, {
