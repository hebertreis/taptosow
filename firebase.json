{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "send-din-din/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/createPaymentIntent",
        "function": "createPaymentIntent"
      },
      {
        "source": "/a",
        "function": "redirectAuto"
      },
      {
        "source": "/rampchurchdmv",
        "function": "redirectAuto"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}