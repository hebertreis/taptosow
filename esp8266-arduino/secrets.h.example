/**
 * SECRETS CONFIGURATION TEMPLATE
 * 
 * This file contains sensitive configuration values.
 * DO NOT commit this file to version control!
 * 
 * Instructions:
 * 1. Copy this file to secrets.h
 * 2. Update values with your production credentials
 * 3. Add secrets.h to .gitignore
 * 4. Never share or commit secrets.h
 */

#ifndef SECRETS_H
#define SECRETS_H

// ============================================================================
// MQTT Configuration
// ============================================================================

// MQTT Broker Credentials
// Get these from your EMQX Cloud console
#define SECRETS_MQTT_USERNAME "onetapgo"
#define SECRETS_MQTT_PASSWORD "change_this_to_strong_password"

// MQTT Broker Settings
#define SECRETS_MQTT_HOST "m191dfff.ala.us-east-1.emqxsl.com"
#define SECRETS_MQTT_PORT 8883

// ============================================================================
// WiFi Configuration
// ============================================================================

// WiFi Access Point Password (for configuration portal)
// Must be at least 8 characters
#define SECRETS_WIFI_AP_PASSWORD "onetapgo123"

// Optional: Pre-configure WiFi credentials for known networks
#define SECRETS_WIFI_SSID ""
#define SECRETS_WIFI_PASSWORD ""

// ============================================================================
// OTA Update Configuration
// ============================================================================

// OTA Update Password (minimum 8 characters)
#define SECRETS_OTA_PASSWORD "change_ota_password"

// Optional: Use password hash instead of plain text
// Generate with: echo -n "password" | md5sum
// #define SECRETS_OTA_PASSWORD_HASH ""

// ============================================================================
// Device Authentication
// ============================================================================

// Unique device secret (generate per device)
// Use: openssl rand -hex 32
#define SECRETS_DEVICE_SECRET "change_this_per_device"

// Device ID prefix (optional, auto-generated from MAC if empty)
#define SECRETS_DEVICE_ID_PREFIX "onetapgo_device"

// ============================================================================
// Firebase Configuration (if using direct access)
// ============================================================================

#define SECRETS_FIREBASE_API_KEY ""
#define SECRETS_FIREBASE_PROJECT_ID ""
#define SECRETS_FIREBASE_MESSAGING_SENDER_ID ""
#define SECRETS_FIREBASE_APP_ID ""

// ============================================================================
// TLS/SSL Certificates
// ============================================================================

// MQTT Broker CA Certificate (for verification)
// Download from: openssl s_client -showcerts -connect host:port </dev/null
#define SECRETS_MQTT_CA_CERT R"EOF(
-----BEGIN CERTIFICATE-----
Paste your CA certificate here
-----END CERTIFICATE-----
)EOF"

// ============================================================================
// Feature Flags
// ============================================================================

// Enable/disable features for production
#define SECRETS_ENABLE_OTA true
#define SECRETS_ENABLE_DEBUG false
#define SECRETS_ENABLE_SERIAL_DEBUG false

// ============================================================================
// Production Mode
// ============================================================================

// Uncomment to enable production mode (disables debug output)
// #define PRODUCTION

#endif // SECRETS_H

// ============================================================================
// USAGE EXAMPLE
// ============================================================================
/*
 * In your main code (onetapgo.ino):
 * 
 * #include "secrets.h"
 * 
 * void mqttInit() {
 *     // Use secrets
 *     const char* username = SECRETS_MQTT_USERNAME;
 *     const char* password = SECRETS_MQTT_PASSWORD;
 *     
 *     // Connect with credentials
 *     mqttClient.connect(deviceId.c_str(), username, password);
 * }
 * 
 * void otaInit() {
 *     #if SECRETS_ENABLE_OTA
 *         ArduinoOTA.setPassword(SECRETS_OTA_PASSWORD);
 *         ArduinoOTA.begin();
 *     #endif
 * }
 * 
 * void setup() {
 *     #if !SECRETS_ENABLE_SERIAL_DEBUG
 *         Serial.begin(0); // Disable serial
 *     #else
 *         Serial.begin(115200);
 *     #endif
 * }
 */
